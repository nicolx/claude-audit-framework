{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/on-file-edit.sh 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking edited file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .claude/hooks/on-stop.sh ]; then bash .claude/hooks/on-stop.sh; fi",
            "timeout": 600,
            "statusMessage": "Running the quality gate..."
          }
        ]
      }
    ]
  }
}
